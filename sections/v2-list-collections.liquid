{%- liquid
  assign excluded_handles = 'all,frontpage' | split: ','
-%}

<style>
  .v2-collections-{{ section.id }} {
    --v2c-gold: #c9a84c;
    --v2c-gold-dim: rgba(201, 168, 76, 0.08);
    --v2c-gold-line: rgba(201, 168, 76, 0.2);
    --v2c-black: #080808;
    --v2c-bg: #0a0a08;
    --v2c-panel: #111110;
    --v2c-card: #131311;
    --v2c-border: #1e1e1a;
    --v2c-text: #e8e4dc;
    --v2c-muted: #6a6860;
    --v2c-dim: #2e2e2a;
    --v2c-green: #4caf7d;
    --v2c-green-dim: rgba(76, 175, 125, 0.08);
    background: var(--v2c-bg);
    color: var(--v2c-text);
  }

  .v2-collections-{{ section.id }} * {
    box-sizing: border-box;
    letter-spacing: 0;
  }

  .v2-collections-{{ section.id }} {
    position: relative;
  }

  .v2-collections-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.022;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 180px;
    z-index: 0;
  }

  .v2-collections__header-{{ section.id }} {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 6.4rem 3.2rem 5.2rem;
    border-bottom: 1px solid var(--v2c-border);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 4rem;
  }

  .v2-collections__eyebrow-{{ section.id }} {
    margin-bottom: 1.4rem;
    color: var(--v2c-gold);
    opacity: 0.5;
    font-family: var(--font-body-family);
    font-size: 0.9rem;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .v2-collections__title-{{ section.id }} {
    margin: 0;
    color: var(--v2c-text);
    font-family: var(--font-heading-family);
    font-size: 6.4rem;
    font-weight: 400;
    line-height: 0.95;
    white-space: nowrap;
    letter-spacing: 0;
  }

  .v2-collections__title-{{ section.id }} em {
    color: var(--v2c-gold);
    font-style: italic;
  }

  .v2-collections__header-right-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.2rem;
  }

  .v2-collections__gold-pill-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1.6rem;
    background: var(--v2c-gold-dim);
    border: 1px solid var(--v2c-gold-line);
  }

  .v2-collections__gold-dot-{{ section.id }} {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--v2c-gold);
    animation: v2-collections-glow-{{ section.id }} 2s ease-in-out infinite;
  }

  @keyframes v2-collections-glow-{{ section.id }} {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .v2-collections__gold-text-{{ section.id }} {
    color: var(--v2c-gold);
    font-family: var(--font-body-family);
    font-size: 1rem;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .v2-collections__count-{{ section.id }} {
    color: var(--v2c-muted);
    font-family: var(--font-body-family);
    font-size: 1.1rem;
    letter-spacing: 0;
  }

  .v2-collections__count-{{ section.id }} span {
    color: var(--v2c-text);
    font-weight: 500;
  }

  .v2-collections__grid-wrap-{{ section.id }} {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 4rem 3.2rem 8rem;
  }

  .v2-collections__grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.4rem;
  }

  .v2-collections__card-{{ section.id }} {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--v2c-card);
    border: 1px solid var(--v2c-border);
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.3s ease;
    animation: v2-collections-fade-up-{{ section.id }} 0.5s ease both;
  }

  .v2-collections__card-{{ section.id }}:hover {
    border-color: var(--v2c-gold-line);
  }

  .v2-collections__card-{{ section.id }}:focus-visible {
    outline: 2px solid var(--v2c-gold);
    outline-offset: 4px;
  }

  .v2-collections__card-{{ section.id }}[hidden],
  .v2-collections__empty-{{ section.id }}[hidden] { display: none; }

  .v2-collections__card-{{ section.id }}:nth-child(1) { animation-delay: 0.05s; }
  .v2-collections__card-{{ section.id }}:nth-child(2) { animation-delay: 0.12s; }
  .v2-collections__card-{{ section.id }}:nth-child(3) { animation-delay: 0.19s; }
  .v2-collections__card-{{ section.id }}:nth-child(4) { animation-delay: 0.26s; }
  .v2-collections__card-{{ section.id }}:nth-child(5) { animation-delay: 0.33s; }
  .v2-collections__card-{{ section.id }}:nth-child(6) { animation-delay: 0.40s; }

  @keyframes v2-collections-fade-up-{{ section.id }} {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .v2-collections__artwork-{{ section.id }} {
    aspect-ratio: 16 / 9;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--v2c-panel);
  }

  .v2-collections__artwork-bg-{{ section.id }} {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 55%, #141411, #080808);
  }

  .v2-collections__artwork-media-{{ section.id }} {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .v2-collections__artwork-media-{{ section.id }}[hidden],
  .v2-collections__artwork-fallback-{{ section.id }}[hidden] { display: none; }

  .v2-collections__artwork-fallback-{{ section.id }} {
    position: relative;
    z-index: 1;
    padding: 2.4rem;
    text-align: center;
    color: var(--v2c-gold);
    font-family: var(--font-heading-family);
    font-size: 2.6rem;
    font-style: italic;
    line-height: 1.1;
  }

  .v2-collections__card-{{ section.id }}:hover .v2-collections__artwork-media-{{ section.id }} {
    transform: scale(1.04);
  }

  .v2-collections__badge-{{ section.id }} {
    position: absolute;
    top: 1.4rem;
    left: 1.4rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.9rem;
    color: var(--v2c-green);
    background: var(--v2c-green-dim);
    border: 1px solid rgba(76, 175, 125, 0.18);
    font-family: var(--font-body-family);
    font-size: 0.8rem;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .v2-collections__badge-dot-{{ section.id }} {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
  }

  .v2-collections__body-{{ section.id }} {
    container-type: inline-size;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2.4rem;
  }

  .v2-collections__name-{{ section.id }} {
    margin: 0;
    color: var(--v2c-text);
    font-family: var(--font-heading-family);
    font-size: 2rem;
    font-style: normal;
    font-weight: 400;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .v2-collections__identity-{{ section.id }} {
    display: grid;
    grid-template-columns: 4.4rem minmax(0, 1fr);
    align-items: center;
    gap: 1.2rem;
  }

  .v2-collections__avatar-{{ section.id }} {
    display: grid;
    place-items: center;
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 50%;
    overflow: hidden;
    background: var(--v2c-black);
    border: 1px solid var(--v2c-gold-line);
    color: var(--v2c-gold);
    font-family: var(--font-heading-family);
    font-size: 1.6rem;
  }

  .v2-collections__avatar-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .v2-collections__avatar-{{ section.id }} [hidden] { display: none; }
  .v2-collections__avatar-{{ section.id }} img[data-brand-core] { object-fit: contain; padding: 0.5rem; }

  .v2-collections__heading-{{ section.id }} {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    min-width: 0;
  }

  .v2-collections__byline-{{ section.id }} {
    color: #a79e8b;
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .v2-collections__byline-{{ section.id }} span { color: var(--v2c-text); }

  .v2-collections__description-{{ section.id }} {
    margin: 0;
    color: #a79e8b;
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    line-height: 1.6;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  .v2-collections__metrics-{{ section.id }} {
    display: contents;
  }

  .v2-collections__metrics-{{ section.id }} > div { flex: 0 0 auto; min-width: 0; }
  .v2-collections__metrics-{{ section.id }} > div:not(:last-child) { margin-inline-end: auto; }

  .v2-collections__metrics-{{ section.id }} dt {
    font-family: var(--font-heading-family);
    font-size: 1rem;
    line-height: 1.6;
    color: #a79e8b;
    text-transform: uppercase;
    min-height: 3.2rem;
    display: flex;
    align-items: flex-end;
  }

  .v2-collections__metrics-{{ section.id }} dd {
    margin: 0.8rem 0 0;
    font-family: var(--font-heading-family);
    font-size: 2rem;
    line-height: 1.4;
    color: #eabf50;
    white-space: nowrap;
  }

  .v2-collections__progress-{{ section.id }} {
    margin-top: auto;
    padding-top: 0.4rem;
  }

  .v2-collections__progress-row-{{ section.id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 0.8rem;
    color: #a79e8b;
    font-family: var(--font-heading-family);
    font-size: 1.1rem;
    line-height: 1.6;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .v2-collections__progress-row-{{ section.id }} strong {
    color: var(--v2c-gold);
    font-weight: 500;
  }

  .v2-collections__track-{{ section.id }} {
    height: 3px;
    background: #1d1c1b;
    position: relative;
    transition: background 0.35s ease;
  }

  .v2-collections-{{ section.id }} .v2-collections__fill-{{ section.id }} {
    display: block;
    width: 0;
    height: 100%;
    background: var(--v2c-gold);
    transition: width 0.35s ease;
  }

  .v2-collections__price-row-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1.6rem 1.2rem;
    margin-top: auto;
  }

  .v2-collections__cta-{{ section.id }} {
    display: inline-flex;
    flex: 0 0 auto;
    margin-inline-start: auto;
    align-items: center;
    gap: 1rem;
    min-height: 5rem;
    padding: 1.4rem 2rem;
    justify-content: center;
    background: var(--v2c-gold);
    color: var(--v2c-black);
    font-family: var(--font-heading-family);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
    transition: all 0.2s ease;
  }

  .v2-collections__card-{{ section.id }}:hover .v2-collections__cta-{{ section.id }} {
    background: #e8c96a;
  }

  @container (max-width: 440px) {
    .v2-collections__metrics-{{ section.id }} dd { font-size: 1.6rem; }
    .v2-collections__cta-{{ section.id }} { padding-inline: 1rem; }
    .v2-collections__cta-arrow-{{ section.id }} { display: none; }
  }

  @container (max-width: 360px) {
    .v2-collections__price-row-{{ section.id }} { column-gap: 0.6rem; }
    .v2-collections__metrics-{{ section.id }} dt { max-width: 6.8rem; }
  }

  @container (max-width: 299px) {
    .v2-collections__price-row-{{ section.id }} { column-gap: 0.4rem; }
    .v2-collections__metrics-{{ section.id }} dt { max-width: 6rem; font-size: 0.9rem; }
    .v2-collections__metrics-{{ section.id }} dd { font-size: 1.4rem; }
    .v2-collections__cta-{{ section.id }} { padding-inline: 0.8rem; font-size: 1.2rem; }
  }

  .v2-collections__empty-{{ section.id }} {
    position: relative;
    z-index: 1;
    padding: 12rem 5.6rem;
    text-align: center;
  }

  .v2-collections__empty-{{ section.id }} p {
    color: var(--v2c-muted);
    font-family: var(--font-body-family);
    font-size: 1.4rem;
  }

  @media screen and (max-width: 1199px) {
    .v2-collections__grid-{{ section.id }} { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .v2-collections__body-{{ section.id }} { padding: 2rem; }
  }

  @media screen and (max-width: 989px) {
    .v2-collections__header-{{ section.id }} {
      padding: 4.8rem 2.4rem 4rem;
      flex-direction: column;
      align-items: flex-start;
    }

    .v2-collections__header-right-{{ section.id }} {
      align-items: flex-start;
    }

    .v2-collections__grid-wrap-{{ section.id }} {
      padding: 3.2rem 2.4rem 5.6rem;
    }

    .v2-collections__title-{{ section.id }} {
      font-size: 4.4rem;
    }

    .v2-collections__body-{{ section.id }} {
      padding: 2rem;
    }

  }

  @media screen and (max-width: 749px) {
    .v2-collections__header-{{ section.id }} { padding: 3.6rem 1.6rem 3.2rem; gap: 2.4rem; }
    .v2-collections__title-{{ section.id }} { font-size: 3.2rem; }
    .v2-collections__grid-wrap-{{ section.id }} { padding: 2.4rem 1.6rem 4.8rem; }
    .v2-collections__grid-{{ section.id }} { grid-template-columns: minmax(0, 1fr); }
    .v2-collections__body-{{ section.id }} { padding: 1.6rem; }
  }

  @media screen and (max-width: 389px) {
    .v2-collections__title-{{ section.id }} { font-size: 2.8rem; }
  }

  @media screen and (max-width: 349px) {
    .v2-collections__title-{{ section.id }} { font-size: 2.6rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .v2-collections-{{ section.id }} *, .v2-collections-{{ section.id }} *::before { animation: none; transition: none; }
  }
</style>

{%- liquid
  case section.settings.sort
    when 'products_high', 'products_low'
      assign sorted_collections = collections | sort: 'all_products_count'
    when 'date', 'date_reversed'
      assign sorted_collections = collections | sort: 'published_at'
    else
      assign sorted_collections = collections | sort: 'title'
  endcase

  if section.settings.sort == 'products_high' or section.settings.sort == 'date_reversed' or section.settings.sort == 'alphabetical_reversed'
    assign sorted_collections = sorted_collections | reverse
  endif

-%}

<div class="v2-collections-{{ section.id }}">
  <div class="v2-collections__header-{{ section.id }}">
    <div>
      <div class="v2-collections__eyebrow-{{ section.id }}">IRIS NYC</div>
      <h1 class="v2-collections__title-{{ section.id }}">Active <em>Collections</em></h1>
    </div>
    <div class="v2-collections__header-right-{{ section.id }}">
      <div class="v2-collections__gold-pill-{{ section.id }}" data-gold-pill>
        <div class="v2-collections__gold-dot-{{ section.id }}"></div>
        <div class="v2-collections__gold-text-{{ section.id }}">Gold — / g · Min —</div>
      </div>
      <div class="v2-collections__count-{{ section.id }}" data-active-count></div>
    </div>
  </div>

  {%- liquid
    assign rendered_count = 0
  -%}
  <div class="v2-collections__grid-wrap-{{ section.id }}">
    <div class="v2-collections__grid-{{ section.id }}" data-collections-grid>
      {%- for collection_group in (1..2) -%}
      {%- for collection in sorted_collections limit: 30 -%}
        {%- liquid
          assign first_product = collection.products.first
          assign archive_handle = first_product.handle | default: collection.handle
          assign is_primary_collection = false
          if archive_handle == 'iris-the-unseen-edition' or archive_handle == 'iris-collection' or archive_handle == 'iris'
            assign is_primary_collection = true
          endif
          if collection_group == 1 and is_primary_collection == false
            continue
          elsif collection_group == 2 and is_primary_collection
            continue
          endif
        -%}
        {%- unless excluded_handles contains collection.handle -%}
          {%- liquid
            assign card_link = collection.url
            if first_product != blank
              assign card_link = first_product.url
            endif

            assign display_title = collection.title
            if archive_handle == 'iris-the-unseen-edition' or archive_handle == 'iris-collection' or archive_handle == 'iris'
              assign display_title = 'IRIS Collection'
            endif

            assign card_image = collection.image
            if card_image == blank and first_product != blank
              assign card_image = first_product.featured_media.preview_image | default: first_product.featured_image
            endif

            assign card_media_class = 'v2-collections__artwork-media-' | append: section.id

            assign brand_name = first_product.vendor | default: shop.name
            assign brand_avatar = nil
            if archive_handle == 'iris-the-unseen-edition' or archive_handle == 'iris-collection' or archive_handle == 'iris'
              assign brand_name = 'IRIS NYC'
              assign brand_avatar = settings.logo
            endif
            assign card_description = collection.description | strip_html | strip
            if card_description == blank or card_description == '.'
              if first_product != blank
                assign card_description = first_product.description | split: '</p>' | first | strip_html | strip
              endif
            endif

            assign card_price = nil
            if first_product != blank and first_product.price
              assign card_price = first_product.price | money_without_trailing_zeros
            endif

            assign rendered_count = rendered_count | plus: 1
          -%}
          <a
            href="{{ card_link }}"
            class="v2-collections__card-{{ section.id }}"
            data-collection-card
            data-collection-handle="{{ archive_handle | escape }}"
            data-collection-title="{{ display_title | escape }}"
          >
            <div class="v2-collections__artwork-{{ section.id }}">
              <div class="v2-collections__artwork-bg-{{ section.id }}"></div>
              <img
                class="{{ card_media_class }}"
                data-collection-banner
                {% if card_image != blank %}data-fallback-src="{{ card_image | image_url: width: 1200 }}"{% endif %}
                width="1200"
                height="675"
                loading="eager"
                alt="{{ display_title | escape }}"
                hidden
              >
              <div class="v2-collections__artwork-fallback-{{ section.id }}" hidden>{{ display_title }}</div>
              <noscript>
              {%- if card_image != blank -%}
                {{ card_image | image_url: width: 1200 | image_tag:
                  class: card_media_class,
                  loading: 'lazy',
                  alt: display_title
                }}
              {%- else -%}
                <div class="v2-collections__artwork-fallback-{{ section.id }}">{{ display_title }}</div>
              {%- endif -%}
              </noscript>
              <div class="v2-collections__badge-{{ section.id }}"><span class="v2-collections__badge-dot-{{ section.id }}"></span>Active</div>
            </div>

            <div class="v2-collections__body-{{ section.id }}">
              <div class="v2-collections__identity-{{ section.id }}">
                <div class="v2-collections__avatar-{{ section.id }}" aria-hidden="true">
                  <span data-collection-brand-initial{% if brand_avatar != blank %} hidden{% endif %}>{{ brand_name | slice: 0 | upcase | escape }}</span>
                  <img data-collection-brand-avatar width="44" height="44" alt=""{% if brand_avatar != blank %} src="{{ brand_avatar | image_url: width: 132 }}" data-brand-core{% else %} hidden{% endif %}>
                </div>
                <div class="v2-collections__heading-{{ section.id }}">
                  <h2 class="v2-collections__name-{{ section.id }}">{{ display_title | escape }}</h2>
                  <div class="v2-collections__byline-{{ section.id }}">By <span data-collection-brand-name>{{ brand_name | escape }}</span></div>
                </div>
              </div>

              <p class="v2-collections__description-{{ section.id }}" data-collection-description>{{ card_description | escape }}</p>

              <div class="v2-collections__price-row-{{ section.id }}">
                <dl class="v2-collections__metrics-{{ section.id }}">
                  <div><dt>Edition size</dt><dd data-collection-edition>—</dd></div>
                  <div><dt title="Average gold weight of sold IRIS with a recorded weight">Avg. gold</dt><dd data-collection-average-weight>—</dd></div>
                  <div><dt>Price</dt><dd>{{ card_price | default: '—' }}</dd></div>
                </dl>
                <div class="v2-collections__cta-{{ section.id }}"><span>Reveal</span><span class="v2-collections__cta-arrow-{{ section.id }}" aria-hidden="true">→</span></div>
              </div>

              {%- comment -%}Temporarily hide sales figures while keeping the counter ready to restore.{%- endcomment -%}
              <div class="v2-collections__progress-{{ section.id }}" hidden>
                <div class="v2-collections__progress-row-{{ section.id }}">
                  <span>Sold</span>
                  <strong data-collection-count>—</strong>
                </div>
                <div class="v2-collections__track-{{ section.id }}" data-collection-progress>
                  <div class="v2-collections__fill-{{ section.id }}" data-collection-fill></div>
                </div>
              </div>

            </div>
          </a>
        {%- endunless -%}
      {%- endfor -%}
      {%- endfor -%}
    </div>

      <div class="v2-collections__empty-{{ section.id }}" data-collections-empty{% if rendered_count > 0 %} hidden{% endif %}>
        <p>No collections are visible yet.</p>
      </div>
  </div>
</div>

<script>
  (function() {
    var sectionId = {{ section.id | json }};
    var root = document.querySelector('.v2-collections-' + sectionId);
    if (!root) return;

    function formatNumber(value) {
      return new Intl.NumberFormat('en-US').format(value);
    }

    function updateGoldPill() {
      var pill = root.querySelector('[data-gold-pill] .v2-collections__gold-text-' + sectionId);
      if (!pill) return;
      var cacheKey = 'iris-live-gold-price';
      var cached = null;
      try {
        var raw = localStorage.getItem(cacheKey);
        if (raw) {
          var parsed = JSON.parse(raw);
          if (parsed && typeof parsed.value === 'number' && typeof parsed.ts === 'number' && (Date.now() - parsed.ts) < (30 * 60 * 1000)) {
            cached = parsed.value;
          }
        }
      } catch (_) {}

      function setValue(price) {
        var minPrice = Math.ceil(((price * 0.4) + 20) * 1.5);
        pill.textContent = 'Gold $' + price.toFixed(2) + ' / g · Min $' + minPrice;
      }

      if (typeof cached === 'number') {
        setValue(cached);
        return;
      }

      fetch('/apps/iris/gold-price', { headers: { Accept: 'application/json' } })
        .then(function(res) { return res.ok ? res.json() : null; })
        .then(function(data) {
          var price = Number(data && data.price_usd_g);
          if (!Number.isFinite(price) || price <= 0) return;
          try {
            localStorage.setItem(cacheKey, JSON.stringify({ value: price, ts: Date.now() }));
          } catch (_) {}
          setValue(price);
        })
        .catch(function() {});
    }

    function updateActiveCount() {
      var countEl = root.querySelector('[data-active-count]');
      if (!countEl) return;
      var total = root.querySelectorAll('[data-collection-card]:not([hidden])').length;
      countEl.innerHTML = '<span>' + total + '</span> editions currently active';
      var emptyEl = root.querySelector('[data-collections-empty]');
      if (emptyEl) emptyEl.hidden = total > 0;
    }

    function hydrateCards() {
      var cards = root.querySelectorAll('[data-collection-card]');
      cards.forEach(function(card) {
        var handle = card.getAttribute('data-collection-handle');
        var countEl = card.querySelector('[data-collection-count]');
        var editionEl = card.querySelector('[data-collection-edition]');
        var averageWeightEl = card.querySelector('[data-collection-average-weight]');
        var fillEl = card.querySelector('[data-collection-fill]');
        var trackEl = card.querySelector('[data-collection-progress]');
        var brandNameEl = card.querySelector('[data-collection-brand-name]');
        var brandInitialEl = card.querySelector('[data-collection-brand-initial]');
        var brandAvatarEl = card.querySelector('[data-collection-brand-avatar]');
        var descriptionEl = card.querySelector('[data-collection-description]');
        var bannerEl = card.querySelector('[data-collection-banner]');
        var bannerFallbackEl = card.querySelector('.v2-collections__artwork-fallback-' + sectionId);
        var fallbackBannerUrl = bannerEl && bannerEl.getAttribute('data-fallback-src');
        if (!handle) return;

        function loadBanner(url, label) {
          if (!bannerEl) return;
          bannerEl.hidden = true;
          if (bannerFallbackEl) bannerFallbackEl.hidden = !!url;
          if (!url) return;
          bannerEl.alt = label || card.getAttribute('data-collection-title') || '';
          bannerEl.onload = function() { bannerEl.hidden = false; };
          bannerEl.onerror = function() {
            if (fallbackBannerUrl && url !== fallbackBannerUrl) {
              loadBanner(fallbackBannerUrl, label);
            } else if (bannerFallbackEl) {
              bannerFallbackEl.hidden = false;
            }
          };
          bannerEl.src = url;
        }

        if (brandAvatarEl) brandAvatarEl.addEventListener('error', function() {
          brandAvatarEl.hidden = true;
          if (brandInitialEl) brandInitialEl.hidden = false;
        });

        fetch('/apps/iris/collection-presentation?handle=' + encodeURIComponent(handle), {
          headers: { Accept: 'application/json' }
        })
          .then(function(res) { return res.ok ? res.json() : null; })
          .then(function(data) {
            if (!data) {
              loadBanner(fallbackBannerUrl);
              return;
            }
            if (data.visible === false) {
              card.hidden = true;
              updateActiveCount();
              return;
            }
            var name = card.querySelector('.v2-collections__name-' + sectionId);
            if (name && typeof data.display_name === 'string' && data.display_name) name.textContent = data.display_name;

            if (typeof data.brand_name === 'string' && data.brand_name.trim()) {
              if (brandNameEl) brandNameEl.textContent = data.brand_name;
              if (brandInitialEl) brandInitialEl.textContent = data.brand_name.trim().charAt(0).toUpperCase();
            }
            if (brandAvatarEl && typeof data.brand_avatar_url === 'string' && /^https:\/\//.test(data.brand_avatar_url)) {
              brandAvatarEl.src = data.brand_avatar_url;
              brandAvatarEl.hidden = false;
              if (brandInitialEl) brandInitialEl.hidden = true;
            }
            if (descriptionEl && typeof data.description === 'string' && data.description.trim()) descriptionEl.textContent = data.description;

            var averageWeight = data.average_sold_weight_grams;
            if (averageWeightEl && typeof averageWeight === 'number' && Number.isFinite(averageWeight) && averageWeight > 0) {
              averageWeightEl.textContent = averageWeight.toFixed(3) + ' g';
            }

            var sold = data.sold_count;
            var editionSize = data.edition_size;
            if (Number.isSafeInteger(editionSize) && editionSize > 0) {
              if (editionEl) editionEl.textContent = formatNumber(editionSize);
              if (Number.isSafeInteger(sold) && sold >= 0) {
                if (countEl) countEl.textContent = formatNumber(sold) + ' of ' + formatNumber(editionSize);
                if (fillEl) fillEl.style.width = Math.min(100, sold / editionSize * 100) + '%';
                if (trackEl) {
                  trackEl.setAttribute('role', 'progressbar');
                  trackEl.setAttribute('aria-label', 'IRIS sold');
                  trackEl.setAttribute('aria-valuemin', '0');
                  trackEl.setAttribute('aria-valuemax', String(editionSize));
                  trackEl.setAttribute('aria-valuenow', String(Math.min(sold, editionSize)));
                  trackEl.setAttribute('aria-valuetext', formatNumber(sold) + ' of ' + formatNumber(editionSize) + ' sold');
                }
              }
            }

            var bannerUrl = typeof data.banner_url === 'string' && /^https:\/\//.test(data.banner_url)
              ? data.banner_url : fallbackBannerUrl;
            loadBanner(bannerUrl, data.display_name);
          })
          .catch(function() { loadBanner(fallbackBannerUrl); });
      });
    }

    updateGoldPill();
    updateActiveCount();
    hydrateCards();
  })();
</script>

{% schema %}
{
  "name": "V2 Collections Page",
  "settings": [
    {
      "type": "select",
      "id": "sort",
      "label": "Sort",
      "options": [
        { "value": "alphabetical", "label": "Alphabetical" },
        { "value": "alphabetical_reversed", "label": "Alphabetical, reversed" },
        { "value": "date_reversed", "label": "Date, newest first" },
        { "value": "date", "label": "Date, oldest first" },
        { "value": "products_high", "label": "Products, high to low" },
        { "value": "products_low", "label": "Products, low to high" }
      ],
      "default": "alphabetical"
    }
  ]
}
{% endschema %}
