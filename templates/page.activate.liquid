{% layout 'theme' %}

<style>
  body,
  #MainContent,
  main {
    background: #000;
  }

  .iris-activate-wrap {
    --activate-gold: #c9a84c;
    --activate-gold-bright: #eabf50;
    --activate-border: rgba(201, 168, 76, 0.24);
    --activate-border-strong: rgba(201, 168, 76, 0.46);
    --activate-text: #ede8df;
    --activate-muted: #a89f90;
    --activate-panel: #080808;
    --activate-panel-2: #101010;
    max-width: min(92rem, calc(100vw - 4rem));
    margin: 0 auto;
    min-height: calc(100vh - var(--header-height, 0px));
    padding: calc(6.4rem + var(--header-height, 0px)) 2rem 7.2rem;
    text-align: center;
    color: var(--activate-text);
    background: #000;
    border-top: 1px solid var(--activate-border);
  }

  .iris-activate-wrap > h1 {
    max-width: 72rem;
    margin: 0 auto 2rem;
    color: var(--activate-text);
    font-family: var(--font-heading-family);
    font-size: clamp(4.2rem, 6vw, 7.2rem);
    font-weight: 400;
    line-height: 0.96;
    letter-spacing: 0;
  }

  .iris-activate-wrap > h1::after {
    content: "";
    display: block;
    width: 7.6rem;
    height: 1px;
    margin: 2.4rem auto 0;
    background: var(--activate-gold);
    opacity: 0.78;
  }

  .iris-activate-wrap > p,
  #activatedNotice,
  #activateFooter,
  #activateMsg {
    color: var(--activate-muted);
    font-family: var(--font-body-family);
  }

  #activateIntro {
    max-width: 54rem;
    margin: 0 auto 3.4rem;
    font-size: 1.7rem;
    line-height: 1.72;
  }

  #activatedNotice {
    max-width: 54rem;
    margin: 0 auto 2.4rem !important;
    font-size: 1.45rem !important;
    line-height: 1.6;
  }

  .iris-activate-image-wrap {
    max-width: 44rem;
    width: 100%;
    margin: 0 auto 2.6rem;
    padding: 1.4rem;
    background: var(--activate-panel);
    border: 1px solid var(--activate-border);
  }

  .iris-activate-image {
    width: 100%;
    max-width: none;
    aspect-ratio: 1 / 1;
    height: auto;
    display: block;
    object-fit: contain;
    background: #151515;
    border: 0;
    border-radius: 0;
  }

  #irisIdBlock {
    margin: 0 auto 2.2rem !important;
  }

  #irisId {
    color: var(--activate-gold-bright);
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 3vw, 3.2rem) !important;
    font-weight: 400 !important;
    letter-spacing: 0.06em;
  }

  #activateForm {
    max-width: 42rem !important;
    margin: 0 auto !important;
    padding: 2.8rem;
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 2rem !important;
    background: var(--activate-panel);
    border: 1px solid var(--activate-border);
    text-align: center;
  }

  #activateForm label,
  .iris-transfer-claim label {
    display: block;
    margin: 0 0 1rem !important;
    color: var(--activate-muted);
    font-family: var(--font-body-family);
    font-size: 0.98rem !important;
    line-height: 1.3;
    letter-spacing: 0.24rem;
    text-transform: uppercase;
    opacity: 1 !important;
  }

  #activateForm p {
    margin: 0 !important;
    color: var(--activate-muted);
    font-size: 1.25rem !important;
    line-height: 1.5;
    text-align: center !important;
  }

  #pinInput,
  #emailInput,
  #transferEmailInput,
  #transferCodeInput {
    width: 100% !important;
    min-height: 5.8rem;
    padding: 0 1.6rem !important;
    border: 1px solid var(--activate-border-strong) !important;
    border-radius: 0 !important;
    background: #020202 !important;
    color: var(--activate-text) !important;
    font-family: var(--font-heading-family);
    font-size: 1.8rem !important;
    text-align: center !important;
    box-shadow: none !important;
  }

  #pinInput {
    max-width: 18rem;
    margin: 0 auto;
    letter-spacing: 0.16em;
  }

  #emailInput {
    max-width: 32rem;
    margin: 0 auto;
  }

  #pinInput:focus,
  #emailInput:focus,
  #transferEmailInput:focus,
  #transferCodeInput:focus {
    outline: 1px solid var(--activate-gold);
    outline-offset: 3px;
  }

  #transferEmailInput:disabled {
    border-color: var(--activate-border) !important;
    background: #0b0b0b !important;
    color: var(--activate-muted) !important;
    cursor: not-allowed;
    opacity: 1;
  }

  #activateBtn,
  #transferClaimBtn,
  .iris-transfer-success a {
    width: min(100%, 32rem);
    min-height: 5.8rem !important;
    margin: 0 auto;
    padding: 1.4rem 2.2rem !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: 1px solid var(--activate-gold) !important;
    background: var(--activate-gold) !important;
    color: #000 !important;
    font-family: var(--font-body-family);
    font-size: 1.15rem !important;
    font-weight: 700;
    letter-spacing: 0.22rem;
    line-height: 1.2;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: none !important;
    cursor: pointer;
    transition: background 0.22s ease, border-color 0.22s ease, transform 0.22s ease;
  }

  #activateBtn:hover,
  #transferClaimBtn:hover,
  .iris-transfer-success a:hover {
    background: var(--activate-gold-bright) !important;
    border-color: var(--activate-gold-bright) !important;
    transform: translateY(-1px);
  }

  #activateBtn:disabled,
  #transferClaimBtn:disabled {
    cursor: wait;
    opacity: 0.62;
    transform: none;
  }

  #alreadyActivated {
    max-width: 42rem;
    margin: 2.4rem auto 0 !important;
    padding: 2.6rem;
    color: var(--activate-text);
    background: var(--activate-panel);
    border: 1px solid var(--activate-border);
  }

  #activateMsg {
    min-height: 2rem;
    margin-top: 1.8rem !important;
    color: var(--activate-gold-bright);
    font-size: 1.35rem !important;
  }

  #activateFooter {
    max-width: 58rem;
    margin: 2.2rem auto 0 !important;
    color: var(--activate-muted);
    font-size: 1.25rem !important;
    line-height: 1.6;
    opacity: 0.78 !important;
  }

  .iris-activate-wrap.is-success {
    --v2-gold: #c9a84c;
    --v2-gold-dim: #7a6330;
    --v2-surface: #000000;
    --v2-surface-2: #101010;
    --v2-border: rgba(201, 168, 76, 0.16);
    --v2-text: #ede8df;
    --v2-text-mid: #a89f90;
    max-width: none;
    width: 100%;
    padding: 0;
    background: var(--v2-surface);
    color: var(--v2-text);
    border-top: 1px solid var(--v2-border);
    text-align: left;
  }

  .iris-transfer-claim {
    max-width: 460px;
    margin: 24px auto 0;
    padding: 24px;
    background: var(--activate-panel);
    border: 1px solid var(--activate-border);
    color: var(--activate-text);
    text-align: left;
  }

  .iris-transfer-claim[hidden],
  .iris-transfer-success[hidden] {
    display: none;
  }

  .iris-transfer-claim h2,
  .iris-transfer-success h2 {
    margin: 0 0 12px;
    color: var(--activate-text);
    font-family: var(--font-heading-family);
    font-size: 28px;
    line-height: 1.1;
  }

  .iris-transfer-claim p,
  .iris-transfer-success p {
    margin: 0 0 18px;
    color: var(--activate-muted);
    font-size: 14px;
    line-height: 1.6;
    opacity: 1;
  }

  .iris-transfer-claim label {
    margin-top: 1.6rem !important;
  }

  .iris-transfer-claim input {
    margin: 0 0 14px;
  }

  .iris-transfer-success {
    max-width: 520px;
    margin: 24px auto 0;
    padding: 26px;
    background: var(--activate-panel);
    border: 1px solid var(--activate-border);
    color: var(--activate-text);
    text-align: center;
  }

  .iris-activation-success {
    margin: 0;
  }

  .iris-activation-success[hidden] {
    display: none;
  }

  .iris-success-shell {
    max-width: 114rem;
    margin: 0 auto;
    padding: 6.6rem 5.6rem 7.6rem;
  }

  .iris-success-head {
    margin-bottom: 3.2rem;
  }

  .iris-success-card {
    background: var(--v2-surface-2);
    border: 1px solid var(--v2-border);
    padding: 2.2rem;
  }

  .iris-success-eyebrow {
    margin: 0 0 1rem;
    color: var(--v2-gold-dim);
    text-transform: uppercase;
    letter-spacing: 0.32rem;
    font-size: 0.9rem;
    font-family: var(--font-body-family);
  }

  .iris-success-title {
    margin: 0;
    color: var(--v2-text);
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 3.1vw, 4rem);
    line-height: 1.04;
    font-weight: 400;
    letter-spacing: 0.03em;
  }

  .iris-success-copy {
    margin: 1.2rem 0 0;
    max-width: 50rem;
    color: var(--v2-text-mid);
    font-size: 1.45rem;
    line-height: 1.65;
  }

  .iris-success-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.98fr) minmax(32rem, 0.9fr);
    gap: 3rem;
    align-items: start;
    background: var(--v2-surface-2);
    border: 1px solid var(--v2-border);
    padding: 2.4rem;
  }

  .iris-success-media,
  .iris-success-panel {
    background: transparent;
    border: 0;
  }

  .iris-success-media {
    padding: 0;
  }

  .iris-success-media__frame {
    aspect-ratio: 1 / 1;
    background: #202020;
    overflow: hidden;
  }

  .iris-success-media__frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    background: #202020;
  }

  .iris-success-panel {
    align-self: stretch;
    padding: 0 0 0 3rem;
    border-left: 1px solid var(--v2-border);
  }

  .iris-success-panel__title {
    margin: 0;
    color: var(--v2-text);
    font-family: var(--font-heading-family);
    font-size: clamp(2.2rem, 2.6vw, 3.4rem);
    line-height: 1.02;
    font-weight: 400;
  }

  .iris-success-panel__copy {
    margin: 1.1rem 0 0;
    color: var(--v2-text-mid);
    font-size: 1.35rem;
    line-height: 1.6;
  }

  .iris-success-passport {
    display: block;
  }

  .iris-success-passport img {
    width: 100%;
    height: 100%;
  }

  .iris-success-meta {
    margin-top: 2.2rem;
    border-top: 1px solid var(--v2-border);
  }

  .iris-success-meta-row span {
    color: var(--v2-text-mid);
    text-transform: uppercase;
    letter-spacing: 0.16rem;
    font-size: 0.9rem;
  }

  .iris-success-meta-row strong {
    color: var(--v2-text);
    text-align: right;
    font-size: 1.35rem;
    line-height: 1.35;
    font-weight: 400;
  }

  .iris-success-meta-row {
    display: flex;
    justify-content: space-between;
    gap: 1.4rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--v2-border);
  }

  .iris-save-button {
    width: auto;
    min-height: 4.6rem;
    margin-top: 2.2rem;
    padding: 1.2rem 2.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--v2-border);
    background: rgba(201, 168, 76, 0.04);
    color: var(--v2-gold);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.2rem;
    font-size: 1rem;
    transition: all 0.25s ease;
  }

  .iris-save-button:hover {
    border-color: rgba(201, 168, 76, 0.5);
    background: rgba(201, 168, 76, 0.08);
  }

  .iris-success-lower {
    width: 100vw;
    margin: 5.4rem calc(50% - 50vw) 0;
    border-top: 1px solid var(--v2-border);
    background: #080808;
  }

  .iris-success-welcome {
    min-height: 62vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10rem 5.6rem;
    text-align: center;
    border-bottom: 1px solid var(--v2-border);
    background:
      radial-gradient(circle at 50% 50%, rgba(201, 168, 76, 0.055), transparent 42%),
      #080808;
  }

  .iris-success-welcome__inner {
    max-width: 96rem;
  }

  .iris-success-welcome__title {
    margin: 0;
    color: var(--v2-text);
    font-family: var(--font-heading-family);
    font-size: clamp(6.4rem, 8.2vw, 12rem);
    font-weight: 400;
    line-height: 0.93;
    letter-spacing: -0.2rem;
  }

  .iris-success-welcome__title em {
    display: block;
    color: var(--v2-gold);
    font-style: italic;
    font-weight: 400;
  }

  .iris-success-welcome__copy {
    max-width: 78rem;
    margin: 4rem auto 0;
    color: var(--v2-text-mid);
    font-family: var(--font-heading-family);
    font-size: clamp(2rem, 2.1vw, 3rem);
    font-style: italic;
    line-height: 1.62;
  }

  .iris-success-next {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border-bottom: 1px solid var(--v2-border);
    background: #0e0e0c;
  }

  .iris-success-next__copy {
    padding: 10rem 6rem;
    border-right: 1px solid var(--v2-border);
  }

  .iris-success-next__image {
    min-height: 100%;
    background: #080808;
    overflow: hidden;
  }

  .iris-success-next__image img {
    width: 100%;
    height: 100%;
    min-height: 72rem;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .iris-success-next__title {
    margin: 0 0 3rem;
    color: var(--v2-text);
    font-family: var(--font-heading-family);
    font-size: clamp(4.6rem, 5vw, 7.6rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.12rem;
  }

  .iris-success-next__body {
    margin: 0;
    color: var(--v2-text-mid);
    font-family: var(--font-heading-family);
    font-size: 1.75rem;
    line-height: 1.82;
  }

  .iris-success-spec-list {
    margin-top: 4.4rem;
    border-top: 1px solid var(--v2-border);
  }

  .iris-success-spec-row {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--v2-border);
  }

  .iris-success-spec-key {
    width: 17rem;
    flex-shrink: 0;
    color: var(--v2-text-mid);
    font-family: var(--font-body-family);
    font-size: 0.95rem;
    letter-spacing: 0.3rem;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .iris-success-spec-val {
    color: var(--v2-text);
    font-family: var(--font-heading-family);
    font-size: 1.55rem;
    line-height: 1.5;
  }

  .iris-success-spec-val a,
  .iris-success-spec-val a:visited {
    color: var(--v2-gold);
    text-decoration: none;
    font-family: var(--font-body-family);
    font-size: 1.02rem;
    letter-spacing: 0.2rem;
    text-transform: uppercase;
  }

  .iris-success-spec-status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.8rem;
    color: var(--v2-gold);
    font-family: var(--font-body-family);
    font-size: 1.02rem;
    letter-spacing: 0.2rem;
    text-transform: uppercase;
  }

  .iris-success-spec-loader {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.35em;
    min-width: 1.35em;
    color: var(--v2-gold);
    font-size: 1.15em;
    line-height: 1;
    letter-spacing: 0;
    transform: translateY(-0.02em);
  }

  @media screen and (max-width: 989px) {
    .iris-success-shell {
      max-width: 90rem;
      padding: 5rem 3.2rem 5.8rem;
    }

    .iris-success-grid,
    .iris-success-next {
      grid-template-columns: 1fr;
      gap: 2.2rem;
    }

    .iris-success-lower {
      margin-top: 3.4rem;
    }

    .iris-success-grid {
      padding: 2rem;
    }

    .iris-success-panel {
      padding: 2.2rem 0 0;
      border-left: 0;
      border-top: 1px solid var(--v2-border);
    }

    .iris-success-welcome {
      min-height: 52vh;
      padding: 8rem 3.2rem;
    }

    .iris-success-next__copy {
      padding: 7rem 3.2rem;
      border-right: 0;
      border-bottom: 1px solid var(--v2-border);
    }

    .iris-success-next__image img {
      min-height: 48rem;
    }
  }

  @media screen and (max-width: 749px) {
    .iris-activate-wrap {
      max-width: calc(100vw - 2rem);
      padding: calc(4.2rem + var(--header-height, 64px)) 1rem 5.2rem;
    }
    .iris-activate-wrap > h1 {
      font-size: clamp(3.4rem, 13vw, 4.8rem);
    }
    #activateIntro {
      font-size: 1.45rem;
      line-height: 1.68;
    }
    .iris-activate-image-wrap {
      padding: 1rem;
      margin-bottom: 2rem;
    }
    #activateForm {
      padding: 2rem 1.6rem;
    }
    #pinInput,
    #emailInput,
    #transferEmailInput,
    #transferCodeInput {
      min-height: 5.4rem;
      font-size: 1.65rem !important;
    }
    #activateBtn,
    #transferClaimBtn,
    .iris-transfer-success a {
      width: 100%;
      min-height: 5.4rem !important;
    }
    .iris-activate-wrap.is-success {
      padding: 0;
    }
    .iris-success-shell {
      padding: 3.8rem 2rem 4.8rem;
    }
    .iris-success-card {
      padding: 1.6rem;
    }
    .iris-success-grid {
      padding: 1.6rem;
    }
    .iris-success-panel {
      padding: 1.6rem 0 0;
    }
    .iris-success-welcome {
      min-height: 58vh;
      padding: 7rem 2rem;
    }
    .iris-success-welcome__title {
      font-size: clamp(4.2rem, 16vw, 6.4rem);
      letter-spacing: -0.1rem;
    }
    .iris-success-welcome__copy,
    .iris-success-next__body {
      font-size: 1.55rem;
      line-height: 1.72;
    }
    .iris-success-next__copy {
      padding: 5.6rem 2rem;
    }
    .iris-success-next__title {
      font-size: clamp(3.6rem, 13vw, 5.2rem);
    }
    .iris-success-spec-row {
      display: grid;
      gap: 0.8rem;
    }
    .iris-success-spec-key {
      width: auto;
    }
    .iris-success-next__image img {
      min-height: 34rem;
    }
    .iris-success-meta-row {
      display: grid;
      gap: 0.4rem;
    }
    .iris-success-meta-row strong {
      text-align: left;
    }
    .iris-save-button {
      width: 100%;
    }
  }
</style>

<div id="activateWrap" class="page-width iris-activate-wrap">

  <h1 id="activateTitle">Activate your IRIS</h1>

  <p id="activateIntro">
    You are about to activate your IRIS artwork.<br>
    Activation confirms you scanned the NFC tag.
  </p>
  <p id="activatedNotice" hidden style="margin:8px 0 20px;font-size:14px;opacity:.85;">
    This IRIS artwork is already registered to its owner.
  </p>

  <div class="iris-activate-image-wrap">
    <img id="irisPreview" class="iris-activate-image" src="https://cdn.shopify.com/s/files/1/0710/5239/4589/files/P1.png?v=1769584244" alt="IRIS" width="400" height="400">
  </div>

  <div id="irisIdBlock" style="margin:10px 0 20px;padding:0;border:0;border-radius:0px;">
    <div id="irisId" style="font-size:22px;font-weight:600;">—</div>
  </div>

  <form id="activateForm" style="max-width:420px;margin:0 auto;display:flex;flex-direction:column;align-items:center;gap:20px;">
    <div style="text-align:center;">
      <label for="pinInput" style="font-size:12px;opacity:.7;display:block;margin-bottom:10px;">Activation PIN</label>
      <input id="pinInput" type="password" inputmode="numeric" maxlength="6" placeholder="******"
             style="width:160px;height:60px;font-size:20px;text-align:center;color:#333;border:1px solid #111;border-radius:0px;">
    </div>

    {% if customer %}
      <input id="emailInput" type="hidden" value="{{ customer.email | escape }}">
      <p style="font-size:12px;opacity:.6;margin:0 0 12px;text-align:left;">
        Activating as {{ customer.email }}
      </p>
    {% else %}
      <div style="text-align:center;">
        <label for="emailInput" style="font-size:12px;opacity:.7;display:block;margin-bottom:10px;">Email</label>
        <input id="emailInput" type="email"
               style="width:320px;height:60px;font-size:20px;text-align:center;color:#333;border:1px solid #111;border-radius:0px;">
      </div>
    {% endif %}

    <button id="activateBtn" type="submit" class="button button--primary" style="height:60px;display:inline-flex;align-items:center;justify-content:center;">
      Activate my IRIS
    </button>
  </form>

  <section id="transferClaim" class="iris-transfer-claim" hidden aria-live="polite">
    <h2 id="transferClaimTitle">Claim Transfer</h2>
    <p>
      This IRIS has an open ownership transfer. The recipient email is locked to the address that received the transfer code. The NFC scan confirms physical access to the artwork.
    </p>
    <form id="transferClaimForm">
      <label for="transferEmailInput">Recipient email</label>
      <input id="transferEmailInput" type="email" autocomplete="email" {% if customer %}value="{{ customer.email | escape }}"{% endif %} required>

      <label for="transferCodeInput">Transfer code</label>
      <input id="transferCodeInput" type="text" inputmode="numeric" maxlength="12" autocomplete="one-time-code" required>

      <button id="transferClaimBtn" type="submit">Claim My IRIS</button>
    </form>
  </section>

  <section id="transferSuccess" class="iris-transfer-success" hidden aria-live="polite">
    <h2>Transfer Complete</h2>
    <p>
      This IRIS has been transferred to your email. You can now view it in your My IRIS library.
    </p>
    <a id="transferSuccessLink" href="/pages/my-iris">View My IRIS</a>
  </section>

  <section id="activationSuccess" class="iris-activation-success" hidden aria-live="polite">
    <div class="iris-success-shell">
      <div class="iris-success-head">
        <p class="iris-success-eyebrow">Activation Complete</p>
        <h2 class="iris-success-title">Your IRIS is now awake.</h2>
        <p class="iris-success-copy">
          This piece has entered the IRIS archive. Its passport is recorded by IRIS number, activation time, and artwork data.
        </p>
      </div>

      <div class="iris-success-grid">
        <div class="iris-success-media">
          <div class="iris-success-media__frame">
            <img id="successImage" src="https://cdn.shopify.com/s/files/1/0710/5239/4589/files/P1.png?v=1769584244" alt="Activated IRIS" width="900" height="900">
          </div>
        </div>

        <div class="iris-success-panel">
          <p class="iris-success-eyebrow">Activated Work</p>
          <h3 id="successIrisId" class="iris-success-panel__title">—</h3>
          <div class="iris-success-panel__copy">
            This passport preview confirms the image, rarity, and gold content assigned to the activated work.
          </div>

          <div class="iris-success-meta">
            <div class="iris-success-meta-row">
              <span>Activated</span>
              <strong id="successActivatedAt">—</strong>
            </div>
            <div class="iris-success-meta-row">
              <span>Gold Content</span>
              <strong><span id="successWeight">—</span> g (24K)</strong>
            </div>
            <div class="iris-success-meta-row">
              <span>Rarity</span>
              <strong id="successRarity">—</strong>
            </div>
            <div class="iris-success-meta-row">
              <span>Provenance</span>
              <strong id="successProvenance">Registered in the IRIS archive</strong>
            </div>
          </div>

          <a id="saveToIrisBtn" class="iris-save-button" href="{{ routes.storefront_login_url }}?return_to={{ '/pages/my-iris' | url_encode }}">
            Save to My IRIS
          </a>
        </div>
      </div>

      <div class="iris-success-lower">
        <section class="iris-success-welcome">
          <div class="iris-success-welcome__inner">
            <h2 class="iris-success-welcome__title"><em>Welcome</em>to IRIS Collective.</h2>
            <p class="iris-success-welcome__copy">
              You're now part of a growing archive of awakened work - every IRIS piece has its own story, and this one just became part of the record. Save it to your account, and it's yours to revisit any time.
            </p>
          </div>
        </section>

        <section class="iris-success-next">
          <div class="iris-success-next__copy">
            <span class="iris-success-eyebrow">Ownership Roadmap</span>
            <h2 class="iris-success-next__title">COMING NEXT</h2>
            <p class="iris-success-next__body">
              An IRIS piece doesn't end at the moment you unlock it.<br>
              What you're holding today is the start of a longer story - one that keeps being written by everyone who owns,
              shares, and eventually passes on a piece after you.
            </p>

            <div class="iris-success-spec-list">
              <div class="iris-success-spec-row">
                <div class="iris-success-spec-key">Affiliate Program</div>
                <div class="iris-success-spec-val">
                  Bring others into IRIS and be part of how it grows<br>
                  <a href="https://af.uppromote.com/cxzn07-ex/register" target="_blank" rel="noopener">-> Apply now</a>
                </div>
              </div>
              <div class="iris-success-spec-row">
                <div class="iris-success-spec-key">Marketplace</div>
                <div class="iris-success-spec-val">
                  Verified transfers between owners, authenticated by IRIS<br>
                  <span class="iris-success-spec-status">-> In development <span id="marketplaceProgress" class="iris-success-spec-loader" aria-hidden="true">◴</span></span>
                </div>
              </div>
            </div>
          </div>

          <div class="iris-success-next__image">
            <img src="https://cdn.shopify.com/s/files/1/0710/5239/4589/files/scan-banner2.png?v=1777364858" alt="IRIS activation preview" width="1600" height="1600" loading="lazy">
          </div>
        </section>
      </div>
    </div>
  </section>

  <div id="alreadyActivated" hidden style="margin:20px 0 0;font-size:14px;line-height:1.6;text-align:center;">
    <div style="margin:14px 0;">
      <div style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;opacity:.6;">Activated</div>
      <div id="activatedDate" style="font-weight:600;">—</div>
    </div>
    <div style="margin:14px 0;">
      <div style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;opacity:.6;">Rarity</div>
      <div id="activatedRarity" style="font-weight:600;">—</div>
    </div>
    <div style="margin:14px 0;">
      <div style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;opacity:.6;">Gold</div>
      <div><span id="activatedWeight" style="font-weight:600;">—</span> g</div>
    </div>
  </div>

  <p id="activateMsg" style="margin-top:16px;font-size:14px;"></p>

  <p id="activateFooter" style="margin-top:20px;font-size:14px;opacity:.8;">
    After activation, your artwork may appear in the IRIS Seen Collection (no personal data).
  </p>

</div>

<script>
  var isLoggedIn = {% if customer %}true{% else %}false{% endif %};
  var storefrontLoginUrl = {{ routes.storefront_login_url | json }};
  const params = new URLSearchParams(window.location.search);
  const testSuccess = params.get("test_success") === "1";
  let iris = params.get("iris");
  let tokenParam = params.get("token");
  let token = "";

  function startUnicodeLoader(elementId, sequenceArray, intervalMs) {
    var element = document.getElementById(elementId);
    var frameIndex = 0;
    var delay = intervalMs || 150;
    if (!element || !sequenceArray || !sequenceArray.length) return null;

    return setInterval(function () {
      element.textContent = sequenceArray[frameIndex];
      frameIndex = (frameIndex + 1) % sequenceArray.length;
    }, delay);
  }

  startUnicodeLoader("marketplaceProgress", ["◴", "◷", "◶", "◵"], 150);

  function normalize(v){
    if(!v) return "";
    if(/^IRIS-\d{4}$/i.test(v)) return v.toUpperCase();
    var match = v.match(/^(IRIS-\d{4})-(.+)$/i);
    if (match) {
      token = match[2];
      return match[1].toUpperCase();
    }
    const d=(v.match(/\d+/)||[""])[0];
    return "IRIS-"+d.padStart(4,"0").slice(-4);
  }

  const irisId = normalize(iris);
  let resolvedIrisId = irisId;

  document.getElementById("irisId").textContent = irisId || "Unknown";

  const form = document.getElementById("activateForm");
  const pinInput = document.getElementById("pinInput");
  const emailInput = document.getElementById("emailInput");
  const msg = document.getElementById("activateMsg");
  const successSection = document.getElementById("activationSuccess");
  const transferClaim = document.getElementById("transferClaim");
  const transferClaimForm = document.getElementById("transferClaimForm");
  const transferClaimTitle = document.getElementById("transferClaimTitle");
  const transferEmailInput = document.getElementById("transferEmailInput");
  const transferCodeInput = document.getElementById("transferCodeInput");
  const transferClaimBtn = document.getElementById("transferClaimBtn");
  const transferSuccess = document.getElementById("transferSuccess");
  const transferSuccessLink = document.getElementById("transferSuccessLink");

  async function hydrateFromToken(tok) {
    try {
      const res = await fetch("/apps/iris/activation-info?token=" + encodeURIComponent(tok), { headers: { "Accept": "application/json" } });
      if (!res.ok) return;
      const data = await res.json();
      if (data && data.iris_id) {
        resolvedIrisId = data.iris_id;
        document.getElementById("irisId").textContent = data.display_iris_id || data.iris_id;
      }
      if (data && data.image_url) {
        var img = document.getElementById("irisPreview");
        if (img) img.src = data.image_url;
      }
      if (data && data.status === "activated") {
        if (data.transfer_pending) {
          showTransferClaim(data);
        } else {
          showActivated(data);
        }
      }
    } catch (e) {}
  }

  async function hydrateFromIrisId(id) {
    try {
      const res = await fetch("/apps/iris/iris/" + encodeURIComponent(id), { headers: { "Accept": "application/json" } });
      if (!res.ok) return;
      const data = await res.json();
      if (data && data.iris_id) resolvedIrisId = data.iris_id;
      if (data && data.image_url) {
        var img = document.getElementById("irisPreview");
        if (img) img.src = data.image_url;
      }
      if (data && data.status === "activated") {
        if (data.transfer_pending) {
          showTransferClaim(data);
        } else {
          showActivated(data);
        }
      }
    } catch (e) {}
  }

  if (testSuccess) {
    showActivationSuccess({
      status: "ok",
      iris_id: "IRIS-9999",
      display_iris_id: "IRIS-9999",
      image_url: "https://cdn.shopify.com/s/files/1/0710/5239/4589/files/P1.png?v=1769584244",
      activated_at: new Date().toISOString(),
      rarity_code: "Rare",
      weight_grams: 0.24,
      passport_url: "/pages/iris-passport?iris_id=IRIS-9999"
    });
  } else if (!irisId && tokenParam) {
    token = tokenParam;
    hydrateFromToken(tokenParam);
  }

  if (!testSuccess && irisId) {
    hydrateFromIrisId(irisId);
  }

  if (!testSuccess && !irisId && !tokenParam) {
    msg.textContent = "Missing IRIS ID in the link.";
    form.querySelector("button").disabled = true;
  }

  function formatActivationDate(value) {
    if (!value) return "—";
    var d = new Date(value);
    if (isNaN(d.getTime())) return "—";
    return d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
  }

  function showActivated(data) {
    var formEl = document.getElementById("activateForm");
    var box = document.getElementById("alreadyActivated");
    var dateEl = document.getElementById("activatedDate");
    var rarityEl = document.getElementById("activatedRarity");
    var weightEl = document.getElementById("activatedWeight");
    var titleEl = document.getElementById("activateTitle");
    var introEl = document.getElementById("activateIntro");
    var noticeEl = document.getElementById("activatedNotice");
    var footerEl = document.getElementById("activateFooter");
    var irisIdBlock = document.getElementById("irisIdBlock");
    if (formEl) formEl.style.display = "none";
    if (box) box.hidden = false;
    if (dateEl) dateEl.textContent = formatActivationDate(data.activated_at);
    if (rarityEl) rarityEl.textContent = data.rarity_code || "—";
    if (weightEl) {
      var w = data.weight_grams;
      weightEl.textContent = w == null ? "—" : Number(w).toFixed(2);
    }
    if (titleEl) {
      titleEl.textContent = ((data.display_iris_id || data.iris_id || irisId || "IRIS")) + " Activated";
    }
    if (introEl) introEl.style.display = "none";
    if (noticeEl) noticeEl.hidden = false;
    if (footerEl) footerEl.style.display = "none";
    if (irisIdBlock) irisIdBlock.style.display = "none";
  }

  function showTransferClaim(data) {
    var formEl = document.getElementById("activateForm");
    var box = document.getElementById("alreadyActivated");
    var titleEl = document.getElementById("activateTitle");
    var introEl = document.getElementById("activateIntro");
    var noticeEl = document.getElementById("activatedNotice");
    var footerEl = document.getElementById("activateFooter");
    var displayId = data.display_iris_id || data.iris_id || resolvedIrisId || "IRIS";

    resolvedIrisId = data.iris_id || resolvedIrisId;
    if (formEl) formEl.style.display = "none";
    if (box) box.hidden = true;
    if (transferSuccess) transferSuccess.hidden = true;
    if (transferClaim) transferClaim.hidden = false;
    if (transferClaimTitle) transferClaimTitle.textContent = "Claim Transfer for " + displayId;
    if (titleEl) titleEl.textContent = displayId + " Transfer";
    if (transferEmailInput) {
      if (data.transfer_pending_to) {
        transferEmailInput.value = String(data.transfer_pending_to).trim().toLowerCase();
        transferEmailInput.disabled = true;
        transferEmailInput.setAttribute("aria-disabled", "true");
      } else {
        transferEmailInput.disabled = false;
        transferEmailInput.removeAttribute("aria-disabled");
      }
    }
    if (introEl) {
      introEl.textContent = "Scan confirmed. Enter the transfer code sent by email to claim this IRIS.";
      introEl.style.display = "";
    }
    if (noticeEl) noticeEl.hidden = true;
    if (footerEl) footerEl.style.display = "none";
    msg.textContent = "";
  }

  function showTransferSuccess(data) {
    var titleEl = document.getElementById("activateTitle");
    var introEl = document.getElementById("activateIntro");
    var footerEl = document.getElementById("activateFooter");
    var alreadyBox = document.getElementById("alreadyActivated");
    var displayId = data.display_iris_id || data.iris_id || resolvedIrisId || "IRIS";

    updatePreviewImage(data.image_url);
    if (transferClaim) transferClaim.hidden = true;
    if (alreadyBox) alreadyBox.hidden = true;
    if (successSection) successSection.hidden = true;
    if (transferSuccess) transferSuccess.hidden = false;
    if (transferSuccessLink) {
      transferSuccessLink.href = isLoggedIn
        ? "/pages/my-iris"
        : storefrontLoginUrl + "?return_to=" + encodeURIComponent("/pages/my-iris");
    }
    if (titleEl) titleEl.textContent = displayId + " Claimed";
    if (introEl) {
      introEl.textContent = "Ownership transfer is complete.";
      introEl.style.display = "";
    }
    if (footerEl) footerEl.style.display = "none";
    msg.textContent = "";
  }

  function updatePreviewImage(src) {
    if (!src) return;
    var preview = document.getElementById("irisPreview");
    var successImage = document.getElementById("successImage");
    if (preview) preview.src = src;
    if (successImage) successImage.src = src;
  }

  function showActivationSuccess(data) {
    var formEl = document.getElementById("activateForm");
    var wrapEl = document.getElementById("activateWrap");
    var titleEl = document.getElementById("activateTitle");
    var introEl = document.getElementById("activateIntro");
    var footerEl = document.getElementById("activateFooter");
    var irisIdBlock = document.getElementById("irisIdBlock");
    var previewWrap = document.querySelector(".iris-activate-image-wrap");
    var successIrisId = document.getElementById("successIrisId");
    var successActivatedAt = document.getElementById("successActivatedAt");
    var successRarity = document.getElementById("successRarity");
    var successWeight = document.getElementById("successWeight");
    var saveBtn = document.getElementById("saveToIrisBtn");
    var displayId = data.display_iris_id || data.iris_id || irisId || "IRIS";
    var returnTo = "/pages/my-iris";

    updatePreviewImage(data.image_url);
    if (wrapEl) wrapEl.classList.add("is-success");
    if (formEl) formEl.style.display = "none";
    if (titleEl) titleEl.style.display = "none";
    if (introEl) introEl.style.display = "none";
    if (footerEl) footerEl.style.display = "none";
    if (irisIdBlock) irisIdBlock.style.display = "none";
    if (previewWrap) previewWrap.style.display = "none";
    if (successIrisId) successIrisId.textContent = displayId;
    if (successActivatedAt) successActivatedAt.textContent = formatActivationDate(data.activated_at);
    if (successRarity) successRarity.textContent = data.rarity_code || "—";
    if (successWeight) {
      var w = data.weight_grams;
      successWeight.textContent = w == null ? "—" : Number(w).toFixed(2);
    }
    if (saveBtn) {
      saveBtn.href = isLoggedIn
        ? returnTo
        : storefrontLoginUrl + "?return_to=" + encodeURIComponent(returnTo);
    }
    if (successSection) successSection.hidden = false;
    msg.textContent = "";
  }

  pinInput.addEventListener("input", function () {
    pinInput.style.color = pinInput.value ? "#000" : "#333";
  });

  form.addEventListener("submit", async function (e) {
    e.preventDefault();
    msg.textContent = "";

    const pin = pinInput.value.trim();
    const email = emailInput.value.trim().toLowerCase();
    pinInput.style.color = pin ? "#000" : "#333";
    if (!pin || pin.length < 6) {
      msg.textContent = "Please enter your 6-digit PIN.";
      return;
    }
    if (!email) {
      msg.textContent = "Please enter your email.";
      return;
    }

    try {
      const res = await fetch("/apps/iris/activate-verify", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Accept": "application/json" },
        body: JSON.stringify({ iris_id: token ? (irisId + "-" + token) : irisId, pin, email, token: token || tokenParam })
      });
      const data = await res.json();
      if (!res.ok) {
        if (data.error === "invalid_pin") {
          msg.textContent = "Invalid PIN. Please try again.";
        } else if (data.error === "invalid_activation_link") {
          msg.textContent = "Invalid activation link. Please contact support.";
        } else if (data.error === "too_many_attempts") {
          msg.textContent = "Too many attempts. Please wait and try again.";
        } else if (data.error === "already_activated") {
          msg.textContent = "This IRIS is already activated.";
        } else if (data.error === "pin_not_set") {
          msg.textContent = "PIN not available yet. Please contact support.";
        } else {
          msg.textContent = "Activation failed. Please try again.";
        }
        return;
      }
      showActivationSuccess(data);
    } catch (err) {
      msg.textContent = "Activation failed. Please try again.";
    }
  });

  if (transferClaimForm) {
    transferClaimForm.addEventListener("submit", async function (e) {
      e.preventDefault();
      msg.textContent = "";

      var email = transferEmailInput.value.trim().toLowerCase();
      var transferCode = transferCodeInput.value.trim();
      if (!email) {
        msg.textContent = "Please enter the recipient email.";
        return;
      }
      if (!transferCode) {
        msg.textContent = "Please enter your transfer code.";
        return;
      }

      transferClaimBtn.disabled = true;
      transferClaimBtn.textContent = "Claiming…";
      try {
        const res = await fetch("/apps/iris/transfer-claim", {
          method: "POST",
          headers: { "Content-Type": "application/json", "Accept": "application/json" },
          body: JSON.stringify({
            iris_id: resolvedIrisId || irisId,
            token: token || tokenParam,
            email: email,
            transfer_code: transferCode
          })
        });
        const data = await res.json();
        if (!res.ok) {
          if (data.error === "invalid_transfer_code") {
            msg.textContent = "Invalid transfer code. Please try again.";
          } else if (data.error === "transfer_not_found") {
            msg.textContent = "No open transfer was found for this email.";
          } else if (data.error === "transfer_expired") {
            msg.textContent = "This transfer code has expired. Ask the owner to start a new transfer.";
          } else if (data.error === "invalid_activation_link") {
            msg.textContent = "Please scan the NFC tag again from the physical IRIS.";
          } else if (data.error === "too_many_attempts") {
            msg.textContent = "Too many attempts. Please wait and try again.";
          } else {
            msg.textContent = "Transfer claim failed. Please try again.";
          }
          return;
        }
        showTransferSuccess(data);
      } catch (err) {
        msg.textContent = "Transfer claim failed. Please try again.";
      } finally {
        transferClaimBtn.disabled = false;
        transferClaimBtn.textContent = "Claim My IRIS";
      }
    });
  }
</script>
