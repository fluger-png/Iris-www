{% layout 'theme' %}

<style>
  .iris-activate-wrap {
    padding-top: calc(40px + var(--header-height, 0px));
  }
  .iris-activate-image-wrap {
    max-width: 400px;
    width: 100%;
    margin: 20px auto;
  }
  .iris-activate-image {
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1 / 1;
    height: auto;
    display: block;
    object-fit: contain;
    background: #f3f4f6;
    border: 1px solid #eee;
    border-radius: 0;
  }
  .iris-activation-success {
    display: grid;
    gap: 18px;
    margin: 24px auto 0;
    max-width: 560px;
    text-align: left;
  }
  .iris-activation-success[hidden] {
    display: none;
  }
  .iris-success-card {
    border: 1px solid rgba(234, 191, 80, .32);
    background: rgba(234, 191, 80, .045);
    padding: 22px;
  }
  .iris-success-eyebrow {
    margin: 0 0 10px;
    color: #9a7d31;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .iris-success-title {
    margin: 0 0 10px;
    font-size: 28px;
    line-height: 1.1;
  }
  .iris-success-copy {
    margin: 0;
    color: rgba(0, 0, 0, .72);
    font-size: 15px;
    line-height: 1.55;
  }
  .iris-success-passport {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 18px;
    align-items: center;
  }
  .iris-success-passport img {
    width: 120px;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    background: #f3f4f6;
  }
  .iris-success-meta {
    display: grid;
    gap: 10px;
  }
  .iris-success-meta-row span {
    display: block;
    color: rgba(0, 0, 0, .52);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .iris-success-meta-row strong {
    display: block;
    margin-top: 3px;
    font-size: 15px;
  }
  .iris-save-button {
    width: 100%;
    min-height: 58px;
    margin-top: 2px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }
  @media screen and (max-width: 749px) {
    .iris-activate-wrap {
      padding-top: calc(24px + var(--header-height, 64px));
    }
    .iris-success-card {
      padding: 18px;
    }
    .iris-success-passport {
      grid-template-columns: 92px 1fr;
      gap: 14px;
    }
    .iris-success-passport img {
      width: 92px;
    }
  }
</style>

<div class="page-width iris-activate-wrap" style="max-width:700px;margin:0 auto;padding:40px 16px;text-align:center;">

  <h1 id="activateTitle">Activate your IRIS</h1>

  <p id="activateIntro">
    You are about to activate your IRIS artwork.<br>
    Activation confirms you scanned the NFC tag.
  </p>
  <p id="activatedNotice" hidden style="margin:8px 0 20px;font-size:14px;opacity:.85;">
    This IRIS artwork is already registered to its owner.
  </p>

  <div class="iris-activate-image-wrap">
    <img id="irisPreview" class="iris-activate-image" src="https://cdn.shopify.com/s/files/1/0710/5239/4589/files/P1.png?v=1769584244" alt="IRIS" width="400" height="400">
  </div>

  <div id="irisIdBlock" style="margin:10px 0 20px;padding:0;border:0;border-radius:0px;">
    <div id="irisId" style="font-size:22px;font-weight:600;">—</div>
  </div>

  <form id="activateForm" style="max-width:420px;margin:0 auto;display:flex;flex-direction:column;align-items:center;gap:20px;">
    <div style="text-align:center;">
      <label for="pinInput" style="font-size:12px;opacity:.7;display:block;margin-bottom:10px;">Activation PIN</label>
      <input id="pinInput" type="password" inputmode="numeric" maxlength="6" placeholder="******"
             style="width:160px;height:60px;font-size:20px;text-align:center;color:#333;border:1px solid #111;border-radius:0px;">
    </div>

    {% if customer %}
      <input id="emailInput" type="hidden" value="{{ customer.email | escape }}">
      <p style="font-size:12px;opacity:.6;margin:0 0 12px;text-align:left;">
        Activating as {{ customer.email }}
      </p>
    {% else %}
      <div style="text-align:center;">
        <label for="emailInput" style="font-size:12px;opacity:.7;display:block;margin-bottom:10px;">Email</label>
        <input id="emailInput" type="email"
               style="width:320px;height:60px;font-size:20px;text-align:center;color:#333;border:1px solid #111;border-radius:0px;">
      </div>
    {% endif %}

    <button id="activateBtn" type="submit" class="button button--primary" style="height:60px;display:inline-flex;align-items:center;justify-content:center;">
      Activate my IRIS
    </button>
  </form>

  <section id="activationSuccess" class="iris-activation-success" hidden aria-live="polite">
    <div class="iris-success-card">
      <p class="iris-success-eyebrow">Activation complete</p>
      <h2 class="iris-success-title">Your IRIS is now awake.</h2>
      <p class="iris-success-copy">
        This piece has entered the IRIS archive. Its passport is recorded by IRIS number, activation time, and artwork data.
      </p>
    </div>

    <div class="iris-success-card iris-success-passport">
      <img id="successImage" src="https://cdn.shopify.com/s/files/1/0710/5239/4589/files/P1.png?v=1769584244" alt="Activated IRIS" width="120" height="120">
      <div class="iris-success-meta">
        <div class="iris-success-meta-row">
          <span>IRIS No.</span>
          <strong id="successIrisId">—</strong>
        </div>
        <div class="iris-success-meta-row">
          <span>Activated</span>
          <strong id="successActivatedAt">—</strong>
        </div>
        <div class="iris-success-meta-row">
          <span>Rarity</span>
          <strong id="successRarity">—</strong>
        </div>
        <div class="iris-success-meta-row">
          <span>Gold</span>
          <strong><span id="successWeight">—</span> g 24K</strong>
        </div>
        <div class="iris-success-meta-row">
          <span>Provenance</span>
          <strong id="successProvenance">Registered in the IRIS archive</strong>
        </div>
      </div>
    </div>

    <div class="iris-success-card">
      <p class="iris-success-eyebrow">Welcome</p>
      <p class="iris-success-copy">
        You are now part of the visible IRIS history. Keep this page, save your IRIS to your account, and return to your collection whenever you need it.
      </p>
    </div>

    <div class="iris-success-card">
      <p class="iris-success-eyebrow">Coming next</p>
      <p class="iris-success-copy">
        Owner tools are being prepared for future releases, including collection features and invitation-based referral access.
      </p>
    </div>

    <a id="saveToIrisBtn" class="button button--primary iris-save-button" href="{{ routes.storefront_login_url }}?return_to={{ '/pages/my-iris' | url_encode }}">
      Save to My IRIS
    </a>
  </section>

  <div id="alreadyActivated" hidden style="margin:20px 0 0;font-size:14px;line-height:1.6;text-align:center;">
    <div style="margin:14px 0;">
      <div style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;opacity:.6;">Activated</div>
      <div id="activatedDate" style="font-weight:600;">—</div>
    </div>
    <div style="margin:14px 0;">
      <div style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;opacity:.6;">Rarity</div>
      <div id="activatedRarity" style="font-weight:600;">—</div>
    </div>
    <div style="margin:14px 0;">
      <div style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;opacity:.6;">Gold</div>
      <div><span id="activatedWeight" style="font-weight:600;">—</span> g</div>
    </div>
  </div>

  <p id="activateMsg" style="margin-top:16px;font-size:14px;"></p>

  <p id="activateFooter" style="margin-top:20px;font-size:14px;opacity:.8;">
    After activation, your artwork may appear in the IRIS Seen Collection (no personal data).
  </p>

</div>

<script>
  var isLoggedIn = {% if customer %}true{% else %}false{% endif %};
  var storefrontLoginUrl = {{ routes.storefront_login_url | json }};
  const params = new URLSearchParams(window.location.search);
  const testSuccess = params.get("test_success") === "1";
  let iris = params.get("iris");
  let tokenParam = params.get("token");
  let token = "";

  function normalize(v){
    if(!v) return "";
    if(/^IRIS-\d{4}$/i.test(v)) return v.toUpperCase();
    var match = v.match(/^(IRIS-\d{4})-(.+)$/i);
    if (match) {
      token = match[2];
      return match[1].toUpperCase();
    }
    const d=(v.match(/\d+/)||[""])[0];
    return "IRIS-"+d.padStart(4,"0").slice(-4);
  }

  const irisId = normalize(iris);

  document.getElementById("irisId").textContent = irisId || "Unknown";

  const form = document.getElementById("activateForm");
  const pinInput = document.getElementById("pinInput");
  const emailInput = document.getElementById("emailInput");
  const msg = document.getElementById("activateMsg");
  const successSection = document.getElementById("activationSuccess");

  async function hydrateFromToken(tok) {
    try {
      const res = await fetch("/apps/iris/activation-info?token=" + encodeURIComponent(tok), { headers: { "Accept": "application/json" } });
      if (!res.ok) return;
      const data = await res.json();
      if (data && data.iris_id) {
        document.getElementById("irisId").textContent = data.display_iris_id || data.iris_id;
      }
      if (data && data.image_url) {
        var img = document.getElementById("irisPreview");
        if (img) img.src = data.image_url;
      }
      if (data && data.status === "activated") {
        showActivated(data);
      }
    } catch (e) {}
  }

  async function hydrateFromIrisId(id) {
    try {
      const res = await fetch("/apps/iris/iris/" + encodeURIComponent(id), { headers: { "Accept": "application/json" } });
      if (!res.ok) return;
      const data = await res.json();
      if (data && data.image_url) {
        var img = document.getElementById("irisPreview");
        if (img) img.src = data.image_url;
      }
      if (data && data.status === "activated") {
        showActivated(data);
      }
    } catch (e) {}
  }

  if (testSuccess) {
    showActivationSuccess({
      status: "ok",
      iris_id: "IRIS-9999",
      display_iris_id: "IRIS-9999",
      image_url: "https://cdn.shopify.com/s/files/1/0710/5239/4589/files/P1.png?v=1769584244",
      activated_at: new Date().toISOString(),
      rarity_code: "Rare",
      weight_grams: 0.24,
      passport_url: "/pages/iris-passport?iris_id=IRIS-9999"
    });
  } else if (!irisId && tokenParam) {
    token = tokenParam;
    hydrateFromToken(tokenParam);
  }

  if (!testSuccess && irisId) {
    hydrateFromIrisId(irisId);
  }

  if (!testSuccess && !irisId && !tokenParam) {
    msg.textContent = "Missing IRIS ID in the link.";
    form.querySelector("button").disabled = true;
  }

  function formatActivationDate(value) {
    if (!value) return "—";
    var d = new Date(value);
    if (isNaN(d.getTime())) return "—";
    return d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
  }

  function showActivated(data) {
    var formEl = document.getElementById("activateForm");
    var box = document.getElementById("alreadyActivated");
    var dateEl = document.getElementById("activatedDate");
    var rarityEl = document.getElementById("activatedRarity");
    var weightEl = document.getElementById("activatedWeight");
    var titleEl = document.getElementById("activateTitle");
    var introEl = document.getElementById("activateIntro");
    var noticeEl = document.getElementById("activatedNotice");
    var footerEl = document.getElementById("activateFooter");
    var irisIdBlock = document.getElementById("irisIdBlock");
    if (formEl) formEl.style.display = "none";
    if (box) box.hidden = false;
    if (dateEl) dateEl.textContent = formatActivationDate(data.activated_at);
    if (rarityEl) rarityEl.textContent = data.rarity_code || "—";
    if (weightEl) {
      var w = data.weight_grams;
      weightEl.textContent = w == null ? "—" : Number(w).toFixed(2);
    }
    if (titleEl) {
      titleEl.textContent = ((data.display_iris_id || data.iris_id || irisId || "IRIS")) + " Activated";
    }
    if (introEl) introEl.style.display = "none";
    if (noticeEl) noticeEl.hidden = false;
    if (footerEl) footerEl.style.display = "none";
    if (irisIdBlock) irisIdBlock.style.display = "none";
  }

  function updatePreviewImage(src) {
    if (!src) return;
    var preview = document.getElementById("irisPreview");
    var successImage = document.getElementById("successImage");
    if (preview) preview.src = src;
    if (successImage) successImage.src = src;
  }

  function showActivationSuccess(data) {
    var formEl = document.getElementById("activateForm");
    var titleEl = document.getElementById("activateTitle");
    var introEl = document.getElementById("activateIntro");
    var footerEl = document.getElementById("activateFooter");
    var irisIdBlock = document.getElementById("irisIdBlock");
    var previewWrap = document.querySelector(".iris-activate-image-wrap");
    var successIrisId = document.getElementById("successIrisId");
    var successActivatedAt = document.getElementById("successActivatedAt");
    var successRarity = document.getElementById("successRarity");
    var successWeight = document.getElementById("successWeight");
    var saveBtn = document.getElementById("saveToIrisBtn");
    var displayId = data.display_iris_id || data.iris_id || irisId || "IRIS";
    var returnTo = "/pages/my-iris";

    updatePreviewImage(data.image_url);
    if (formEl) formEl.style.display = "none";
    if (titleEl) titleEl.textContent = displayId + " Activated";
    if (introEl) introEl.style.display = "none";
    if (footerEl) footerEl.style.display = "none";
    if (irisIdBlock) irisIdBlock.style.display = "none";
    if (previewWrap) previewWrap.style.display = "none";
    if (successIrisId) successIrisId.textContent = displayId;
    if (successActivatedAt) successActivatedAt.textContent = formatActivationDate(data.activated_at);
    if (successRarity) successRarity.textContent = data.rarity_code || "—";
    if (successWeight) {
      var w = data.weight_grams;
      successWeight.textContent = w == null ? "—" : Number(w).toFixed(2);
    }
    if (saveBtn) {
      saveBtn.href = isLoggedIn
        ? returnTo
        : storefrontLoginUrl + "?return_to=" + encodeURIComponent(returnTo);
    }
    if (successSection) successSection.hidden = false;
    msg.textContent = "";
  }

  pinInput.addEventListener("input", function () {
    pinInput.style.color = pinInput.value ? "#000" : "#333";
  });

  form.addEventListener("submit", async function (e) {
    e.preventDefault();
    msg.textContent = "";

    const pin = pinInput.value.trim();
    const email = emailInput.value.trim().toLowerCase();
    pinInput.style.color = pin ? "#000" : "#333";
    if (!pin || pin.length < 6) {
      msg.textContent = "Please enter your 6-digit PIN.";
      return;
    }
    if (!email) {
      msg.textContent = "Please enter your email.";
      return;
    }

    try {
      const res = await fetch("/apps/iris/activate-verify", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Accept": "application/json" },
        body: JSON.stringify({ iris_id: token ? (irisId + "-" + token) : irisId, pin, email, token: token || tokenParam })
      });
      const data = await res.json();
      if (!res.ok) {
        if (data.error === "invalid_pin") {
          msg.textContent = "Invalid PIN. Please try again.";
        } else if (data.error === "invalid_activation_link") {
          msg.textContent = "Invalid activation link. Please contact support.";
        } else if (data.error === "too_many_attempts") {
          msg.textContent = "Too many attempts. Please wait and try again.";
        } else if (data.error === "already_activated") {
          msg.textContent = "This IRIS is already activated.";
        } else if (data.error === "pin_not_set") {
          msg.textContent = "PIN not available yet. Please contact support.";
        } else {
          msg.textContent = "Activation failed. Please try again.";
        }
        return;
      }
      showActivationSuccess(data);
    } catch (err) {
      msg.textContent = "Activation failed. Please try again.";
    }
  });
</script>
