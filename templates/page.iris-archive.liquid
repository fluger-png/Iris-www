{% layout 'theme' %}

<style>
  .v2-iris-archive {
    --v2-archive-gold: #c9a84c;
    --v2-archive-gold-dim: #7a6330;
    --v2-archive-bg: #000000;
    --v2-archive-surface: #171717;
    --v2-archive-surface-2: #1d1d1d;
    --v2-archive-border: rgba(201, 168, 76, 0.16);
    --v2-archive-text: #ede8df;
    --v2-archive-text-mid: #a89f90;
    --v2-archive-text-soft: rgba(237, 232, 223, 0.62);
    background: var(--v2-archive-bg);
    color: var(--v2-archive-text);
    border-top: 1px solid var(--v2-archive-border);
    border-bottom: 1px solid var(--v2-archive-border);
  }

  .v2-iris-archive__wrap {
    max-width: 144rem;
    margin: 0 auto;
    padding: 11rem 4rem 12rem;
  }

  .v2-iris-archive__head {
    text-align: center;
    margin-bottom: 4.8rem;
  }

  .v2-iris-archive__eyebrow {
    margin: 0 0 1.8rem;
    color: var(--v2-archive-gold-dim);
    text-transform: uppercase;
    letter-spacing: 0.42rem;
    font-size: 1rem;
    font-family: var(--font-body-family);
  }

  .v2-iris-archive__title {
    margin: 0;
    color: var(--v2-archive-text) !important;
    font-family: var(--font-heading-family);
    font-size: clamp(3.2rem, 5vw, 6rem);
    line-height: 1.06;
    letter-spacing: 0.03em;
    font-weight: 400;
  }

  .v2-iris-archive__title em,
  .v2-iris-archive__title em * {
    color: var(--v2-archive-gold) !important;
    font-style: italic;
    font-weight: 400;
  }

  .v2-iris-archive__description {
    max-width: 76rem;
    margin: 2rem auto 0;
    color: var(--v2-archive-text-mid);
    font-size: 1.7rem;
    line-height: 1.8;
  }

  .v2-iris-archive__filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.2rem;
    margin: 0 0 5.2rem;
  }

  .v2-iris-archive__filter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.6rem;
    padding: 1.2rem 1.9rem;
    border: 1px solid var(--v2-archive-border);
    background: rgba(201, 168, 76, 0.03);
    color: var(--v2-archive-text-mid);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.22rem;
    font-size: 1.05rem;
    transition: all 0.24s ease;
  }

  .v2-iris-archive__filter:hover,
  .v2-iris-archive__filter.is-active {
    color: var(--v2-archive-gold);
    border-color: rgba(201, 168, 76, 0.45);
    background: rgba(201, 168, 76, 0.07);
  }

  .v2-iris-archive__status {
    min-height: 2.4rem;
    text-align: center;
    margin: 0 0 3rem;
    color: var(--v2-archive-text-soft);
    font-size: 1.35rem;
    letter-spacing: 0.08rem;
  }

  .v2-iris-archive__status[hidden] {
    display: none;
  }

  .v2-iris-archive__status--error {
    color: #de7b7b;
  }

  .v2-iris-archive__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .v2-iris-archive__card {
    position: relative;
    display: block;
    background: var(--v2-archive-surface);
    border: 1px solid var(--v2-archive-border);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .v2-iris-archive__card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .v2-iris-archive__card:hover,
  .v2-iris-archive__card.is-hovered {
    border-color: rgba(201, 168, 76, 0.4);
  }

  .v2-iris-archive__media {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--v2-archive-surface-2);
    overflow: hidden;
  }

  .v2-iris-archive__media img {
    position: absolute;
    inset: 10%;
    width: 80%;
    height: 80%;
    object-fit: contain;
    display: block;
    background: #242424;
    transition: transform 0.45s ease;
  }

  .v2-iris-archive__card:hover .v2-iris-archive__media img,
  .v2-iris-archive__card.is-hovered .v2-iris-archive__media img {
    transform: scale(1.035);
  }

  .v2-iris-archive__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: end;
    padding: 2rem;
    background: linear-gradient(180deg, rgba(8, 8, 8, 0.02) 28%, rgba(8, 8, 8, 0.76) 100%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.24s ease;
  }

  .v2-iris-archive__card:hover .v2-iris-archive__overlay,
  .v2-iris-archive__card.is-hovered .v2-iris-archive__overlay {
    opacity: 1;
  }

  .v2-iris-archive__overlay-meta {
    color: var(--v2-archive-gold);
    letter-spacing: 0.12rem;
    font-size: 0.92rem;
    line-height: 1.7;
    white-space: pre-line;
  }

  .v2-iris-archive__body {
    padding: 1.8rem 1.9rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .v2-iris-archive__body-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.2rem;
  }

  .v2-iris-archive__iris,
  .v2-iris-archive__iris:visited {
    color: var(--v2-archive-text);
    font-family: var(--font-heading-family);
    font-size: 1.9rem;
    line-height: 1.1;
    letter-spacing: 0.03em;
    text-decoration: none;
  }

  .v2-iris-archive__iris:hover {
    color: var(--v2-archive-gold);
  }

  .v2-iris-archive__like {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    min-width: 2.8rem;
    margin-top: -0.3rem;
  }

  .v2-iris-archive__like-button {
    width: 2.6rem;
    height: 2.6rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: #4b4a46;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.18s ease, transform 0.18s ease, opacity 0.18s ease;
  }

  .v2-iris-archive__like-button:hover,
  .v2-iris-archive__like-button.is-liked {
    color: var(--v2-archive-gold);
  }

  .v2-iris-archive__like-button:disabled {
    cursor: wait;
    opacity: 0.52;
  }

  .v2-iris-archive__like-button svg {
    width: 2.6rem;
    height: 2.6rem;
    display: block;
    fill: currentColor;
  }

  .v2-iris-archive__like-button:active {
    transform: scale(0.92);
  }

  .v2-iris-archive__like-count {
    display: block;
    min-height: 0.9rem;
    color: var(--v2-archive-text-soft);
    font-size: 0.9rem;
    line-height: 1;
    letter-spacing: 0.04rem;
  }

  .v2-iris-archive__meta {
    color: var(--v2-archive-gold);
    text-transform: uppercase;
    letter-spacing: 0.18rem;
    font-size: 0.95rem;
  }

  .v2-iris-archive__load-wrap {
    text-align: center;
    margin-top: 5rem;
  }

  .v2-iris-archive__load {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 5.8rem;
    min-width: 23rem;
    padding: 1.6rem 3rem;
    border: 1px solid var(--v2-archive-border);
    background: rgba(201, 168, 76, 0.04);
    color: var(--v2-archive-gold);
    text-transform: uppercase;
    letter-spacing: 0.24rem;
    font-size: 1.05rem;
    font-family: var(--font-body-family);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .v2-iris-archive__load:hover {
    background: rgba(201, 168, 76, 0.08);
    border-color: rgba(201, 168, 76, 0.42);
  }

  .v2-iris-archive__load[hidden] {
    display: none;
  }

  .v2-iris-archive__placeholder {
    position: absolute;
    inset: 10%;
    background: linear-gradient(145deg, rgba(201, 168, 76, 0.1), rgba(255, 255, 255, 0.03));
  }

  @media screen and (max-width: 1199px) {
    .v2-iris-archive__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 989px) {
    .v2-iris-archive__wrap {
      padding: 9rem 3.2rem 10rem;
    }

    .v2-iris-archive__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .v2-iris-archive__wrap {
      padding: 7rem 2rem 8rem;
    }

    .v2-iris-archive__eyebrow {
      letter-spacing: 0.28rem;
      font-size: 0.9rem;
    }

    .v2-iris-archive__description {
      font-size: 1.55rem;
      line-height: 1.75;
    }

    .v2-iris-archive__filters {
      gap: 0.8rem;
      margin-bottom: 4rem;
    }

    .v2-iris-archive__filter {
      width: calc(50% - 0.4rem);
      padding-inline: 1rem;
      letter-spacing: 0.16rem;
      font-size: 0.95rem;
    }

    .v2-iris-archive__grid {
      gap: 0.3rem;
    }

    .v2-iris-archive__media img,
    .v2-iris-archive__placeholder {
      inset: 1rem;
      width: calc(100% - 2rem);
      height: calc(100% - 2rem);
    }

    .v2-iris-archive__overlay,
    .v2-iris-archive__body {
      padding-inline: 1.5rem;
    }

    .v2-iris-archive__like {
      position: absolute;
      top: 1.6rem;
      right: 1.6rem;
      z-index: 3;
      min-width: 2.8rem;
      margin-top: 0;
      text-shadow: 0 0.1rem 0.8rem rgba(0, 0, 0, 0.45);
    }

    .v2-iris-archive__like-button {
      color: #4b4a46;
    }

    .v2-iris-archive__iris {
      font-size: 1.65rem;
    }

    .v2-iris-archive__meta,
    .v2-iris-archive__overlay-meta {
      font-size: 0.82rem;
      letter-spacing: 0.14rem;
    }

    .v2-iris-archive__load {
      width: 100%;
      min-width: 0;
    }
  }
</style>

<section class="v2-iris-archive">
  <div class="v2-iris-archive__wrap">
    <div class="v2-iris-archive__head">
      <p class="v2-iris-archive__eyebrow">Revealed Archive</p>
      <h1 class="v2-iris-archive__title">IRIS <em>Archive</em></h1>
      <div class="v2-iris-archive__description">
        Browse the activated works that have already entered the public history of the edition.
        Filter by rarity and explore each revealed IRIS passport.
      </div>
    </div>

    <div class="v2-iris-archive__filters">
      <a class="v2-iris-archive__filter iris-filter is-active" data-rarity="all" href="#">All</a>
      <a class="v2-iris-archive__filter iris-filter" data-rarity="Common" href="#">Common</a>
      <a class="v2-iris-archive__filter iris-filter" data-rarity="Uncommon" href="#">Uncommon</a>
      <a class="v2-iris-archive__filter iris-filter" data-rarity="Rare" href="#">Rare</a>
      <a class="v2-iris-archive__filter iris-filter" data-rarity="Ultra Rare" href="#">Ultra Rare</a>
      <a class="v2-iris-archive__filter iris-filter" data-rarity="Artist Edition" href="#">Artist Edition</a>
    </div>

    <p id="iris-archive-empty" class="v2-iris-archive__status" hidden>No activated IRIS yet.</p>
    <p id="iris-archive-error" class="v2-iris-archive__status v2-iris-archive__status--error" hidden>Could not load IRIS right now.</p>

    <ul id="iris-archive-grid" class="v2-iris-archive__grid"></ul>

    <div class="v2-iris-archive__load-wrap">
      <button id="iris-archive-load" class="v2-iris-archive__load" type="button" hidden>Load more</button>
    </div>
  </div>
</section>

<script>
  (function () {
    var grid = document.getElementById('iris-archive-grid');
    var loadBtn = document.getElementById('iris-archive-load');
    var empty = document.getElementById('iris-archive-empty');
    var error = document.getElementById('iris-archive-error');
    var filterButtons = document.querySelectorAll('.iris-filter');
    var cursor = null;
    var done = false;
    var rarity = 'all';
    var pageSize = 20;
    var fetchLimit = pageSize + 1;
    var defaultImage = 'https://cdn.shopify.com/s/files/1/0710/5239/4589/files/P1.png?v=1769584244';
    var likesEnabled = false;
    var sessionToken = '';
    var likeIcon = '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.08C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>';

    function escapeHtml(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function readStoredSessionToken() {
      try {
        var raw = window.localStorage && window.localStorage.getItem('iris_account_session');
        if (!raw) return '';
        try {
          return decodeURIComponent(raw);
        } catch (error) {
          return raw;
        }
      } catch (error) {
        return '';
      }
    }

    function appendSession(url) {
      if (!sessionToken) return url;
      return url + (url.indexOf('?') === -1 ? '?' : '&') + 'session=' + encodeURIComponent(sessionToken);
    }

    function checkAccountSession() {
      sessionToken = readStoredSessionToken();

      return fetch(appendSession('/apps/iris/v3/session'), {
        headers: { Accept: 'application/json' },
        cache: 'no-store',
        credentials: 'same-origin'
      })
        .then(function (res) {
          if (!res.ok) throw new Error('bad_status');
          return res.json();
        })
        .then(function (data) {
          likesEnabled = !!(data && data.authenticated);
        })
        .catch(function () {
          likesEnabled = false;
        });
    }

    function labelFromId(id) {
      if (!id) return '';
      var clean = String(id).replace(/^IRIS-?/i, '').trim();
      return 'IRIS No. ' + clean;
    }

    function metaFromItem(item) {
      return item && item.rarity_code ? item.rarity_code : 'Activated';
    }

    function formatDate(value) {
      if (!value) return '-';
      var date = new Date(value);
      if (isNaN(date.getTime())) return '-';
      return (date.getMonth() + 1) + '/' + date.getDate() + '/' + date.getFullYear();
    }

    function formatGold(value) {
      if (value === null || value === undefined || value === '') return '-';
      var number = Number(value);
      if (isNaN(number)) return '-';
      return number.toFixed(2) + ' g (24K)';
    }

    function hoverMetaFromItem(item) {
      return 'Activated: ' + formatDate(item && item.activated_at) + '\nGold content: ' + formatGold(item && item.weight_grams);
    }

    function likeHtmlFromItem(item) {
      if (!likesEnabled || item.like_count === undefined || item.like_count === null) return '';

      var liked = !!item.liked_by_me;
      var count = Number(item.like_count);
      if (!isFinite(count)) count = 0;
      var countText = count > 0 ? String(count) : '';

      return (
        '<div class="v2-iris-archive__like">' +
          '<button class="v2-iris-archive__like-button' + (liked ? ' is-liked' : '') + '" type="button" data-iris-like="' + escapeHtml(item.iris_id) + '" aria-pressed="' + (liked ? 'true' : 'false') + '" title="' + (liked ? 'Unlike' : 'Like') + ' ' + escapeHtml(labelFromId(item.display_iris_id || item.iris_id)) + '">' +
            likeIcon +
          '</button>' +
          '<span class="v2-iris-archive__like-count">' + countText + '</span>' +
        '</div>'
      );
    }

    function setLikeButtonState(button, liked, count) {
      button.classList.toggle('is-liked', liked);
      button.setAttribute('aria-pressed', liked ? 'true' : 'false');
      button.setAttribute('title', liked ? 'Unlike' : 'Like');

      var countEl = button.parentNode && button.parentNode.querySelector('.v2-iris-archive__like-count');
      if (countEl) {
        var safeCount = Number(count);
        countEl.textContent = isFinite(safeCount) && safeCount > 0 ? String(safeCount) : '';
      }
    }

    function renderItems(items) {
      var html = items.map(function (item) {
        var href = '/pages/iris-passport?iris_id=' + encodeURIComponent(item.iris_id);
        var media = item.image_url
          ? '<img src="' + escapeHtml(item.image_url) + '" alt="' + escapeHtml(item.iris_id) + '" loading="lazy">'
          : '<div class="v2-iris-archive__placeholder"></div>';
        var label = labelFromId(item.display_iris_id || item.iris_id);

        return (
          '<li>' +
            '<div class="v2-iris-archive__card">' +
              '<a class="v2-iris-archive__card-link" href="' + href + '">' +
                '<div class="v2-iris-archive__media">' +
                  media +
                  '<div class="v2-iris-archive__overlay">' +
                    '<div class="v2-iris-archive__overlay-meta">' + escapeHtml(hoverMetaFromItem(item)) + '</div>' +
                  '</div>' +
                '</div>' +
              '</a>' +
              '<div class="v2-iris-archive__body">' +
                '<div class="v2-iris-archive__body-top">' +
                  '<a class="v2-iris-archive__iris" href="' + href + '">' + escapeHtml(label) + '</a>' +
                  likeHtmlFromItem(item) +
                '</div>' +
                '<div class="v2-iris-archive__meta">' + escapeHtml(metaFromItem(item)) + '</div>' +
              '</div>' +
            '</div>' +
          '</li>'
        );
      }).join('');

      grid.insertAdjacentHTML('beforeend', html);
    }

    function syncLoadButton() {
      loadBtn.hidden = done || !cursor;
    }

    function loadNext() {
      if (done) return;

      error.hidden = true;
      loadBtn.disabled = true;
      loadBtn.textContent = 'Loading...';

      var url = '/apps/iris/seen-archive?limit=' + fetchLimit;
      if (cursor) url += '&cursor=' + encodeURIComponent(cursor);
      if (rarity && rarity !== 'all') url += '&rarity=' + encodeURIComponent(rarity);
      url = appendSession(url);

      fetch(url, { headers: { Accept: 'application/json' }, cache: 'no-store', credentials: 'same-origin' })
        .then(function (res) {
          if (!res.ok) throw new Error('bad_status');
          return res.json();
        })
        .then(function (data) {
          if (data && data.likes_enabled === false) likesEnabled = false;

          var items = data && data.items ? data.items : [];
          if (!items.length && !cursor) {
            empty.hidden = false;
            done = true;
            cursor = null;
            syncLoadButton();
            return;
          }

          if (items.length > pageSize) {
            renderItems(items.slice(0, pageSize));
            cursor = data.nextCursor || null;
          } else {
            renderItems(items);
            cursor = null;
            done = true;
          }

          syncLoadButton();
        })
        .catch(function () {
          error.hidden = false;
          syncLoadButton();
        })
        .finally(function () {
          loadBtn.disabled = false;
          loadBtn.textContent = 'Load more';
        });
    }

    function resetAndLoad(newRarity) {
      rarity = newRarity || 'all';
      cursor = null;
      done = false;
      grid.innerHTML = '';
      empty.hidden = true;
      error.hidden = true;
      syncLoadButton();
      loadNext();
    }

    filterButtons.forEach(function (btn) {
      btn.addEventListener('click', function (event) {
        event.preventDefault();
        filterButtons.forEach(function (item) {
          item.classList.remove('is-active');
        });
        btn.classList.add('is-active');
        resetAndLoad(btn.getAttribute('data-rarity') || 'all');
      });
    });

    function closestArchiveCard(target) {
      return target && target.closest ? target.closest('.v2-iris-archive__card') : null;
    }

    grid.addEventListener('pointerover', function (event) {
      var card = closestArchiveCard(event.target);
      if (!card || (event.relatedTarget && card.contains(event.relatedTarget))) return;
      card.classList.add('is-hovered');
    });

    grid.addEventListener('pointerout', function (event) {
      var card = closestArchiveCard(event.target);
      if (!card || (event.relatedTarget && card.contains(event.relatedTarget))) return;
      card.classList.remove('is-hovered');
    });

    grid.addEventListener('focusin', function (event) {
      var card = closestArchiveCard(event.target);
      if (card) card.classList.add('is-hovered');
    });

    grid.addEventListener('focusout', function (event) {
      var card = closestArchiveCard(event.target);
      if (!card || (event.relatedTarget && card.contains(event.relatedTarget))) return;
      card.classList.remove('is-hovered');
    });

    grid.addEventListener('click', function (event) {
      var target = event.target;
      var button = target && target.closest ? target.closest('[data-iris-like]') : null;
      if (!button) return;

      event.preventDefault();
      event.stopPropagation();

      if (!likesEnabled || button.disabled) return;

      var irisId = button.getAttribute('data-iris-like');
      if (!irisId) return;

      button.disabled = true;

      fetch('/apps/iris/archive-like', {
        method: 'POST',
        headers: {
          Accept: 'application/json',
          'Content-Type': 'application/json'
        },
        cache: 'no-store',
        credentials: 'same-origin',
        body: JSON.stringify({
          iris_id: irisId,
          session: sessionToken
        })
      })
        .then(function (res) {
          if (res.status === 401) {
            window.location.href = '/apps/iris/v3/account?return_to=' + encodeURIComponent('/pages/iris-archive');
            throw new Error('not_authenticated');
          }
          if (!res.ok) throw new Error('bad_status');
          return res.json();
        })
        .then(function (data) {
          if (!data || data.status !== 'ok') throw new Error('bad_payload');
          setLikeButtonState(button, !!data.liked, data.like_count);
        })
        .catch(function () {
          button.classList.add('is-error');
          window.setTimeout(function () {
            button.classList.remove('is-error');
          }, 900);
        })
        .finally(function () {
          button.disabled = false;
        });
    });

    loadBtn.addEventListener('click', loadNext);
    checkAccountSession().then(loadNext);
  })();
</script>
